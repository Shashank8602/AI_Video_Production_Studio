{
  "title": "Why is the night sky dark?",
  "screen": "WHY IS THE\nNIGHT SKY\nDARK?",
  "lines": [
    {
      "id": 1,
      "speaker": "zib",
      "emotion": "excited",
      "camera": "wide",
      "pause_after": 0.8,
      "text": "Bolt! Why is the night sky dark?",
      "pose": {
        "zib": "stand"
      }
    },
    {
      "id": 2,
      "speaker": "bolt",
      "emotion": "thinking",
      "camera": "wide",
      "pause_after": 0.8,
      "text": "Hmm. Good question."
    },
    {
      "id": 3,
      "speaker": "zib",
      "emotion": "confused",
      "camera": "zibClose",
      "pause_after": 0.8,
      "text": "There are so many stars.",
      "pose": {
        "zib": "sit"
      }
    },
    {
      "id": 4,
      "speaker": "bolt",
      "emotion": "neutral",
      "camera": "boltClose",
      "pause_after": 0.8,
      "text": "Yes. Billions of them."
    },
    {
      "id": 5,
      "speaker": "zib",
      "emotion": "doubtful",
      "camera": "zibClose",
      "pause_after": 0.9,
      "text": "So... shouldn't it be bright?"
    },
    {
      "id": 6,
      "speaker": "bolt",
      "emotion": "neutral",
      "camera": "boltClose",
      "pause_after": 0.8,
      "text": "It should. But it isn't."
    },
    {
      "id": 7,
      "speaker": "zib",
      "emotion": "confused",
      "camera": "zibOts",
      "pause_after": 0.8,
      "text": "Why not?"
    },
    {
      "id": 8,
      "speaker": "bolt",
      "emotion": "neutral",
      "camera": "boltOts",
      "pause_after": 0.8,
      "text": "Light takes time to travel."
    },
    {
      "id": 9,
      "speaker": "zib",
      "emotion": "doubtful",
      "camera": "zibClose",
      "pause_after": 0.8,
      "text": "Like a letter in the mail?"
    },
    {
      "id": 10,
      "speaker": "bolt",
      "emotion": "neutral",
      "camera": "boltClose",
      "pause_after": 0.8,
      "text": "Yes! Some starlight is still on its way."
    },
    {
      "id": 11,
      "speaker": "zib",
      "emotion": "wowed",
      "camera": "zibClose",
      "pause_after": 1.0,
      "text": "Ohh! It hasn't arrived yet?",
      "pose": {
        "zib": "stand"
      }
    },
    {
      "id": 12,
      "speaker": "bolt",
      "emotion": "neutral",
      "camera": "boltClose",
      "pause_after": 0.9,
      "text": "Not yet. So the sky stays dark."
    },
    {
      "id": 13,
      "speaker": "zib",
      "emotion": "wowed",
      "camera": "zibClose",
      "pause_after": 1.0,
      "text": "So I'm seeing old light.",
      "pose": {
        "zib": "sit"
      }
    },
    {
      "id": 14,
      "speaker": "bolt",
      "emotion": "sincere",
      "camera": "boltClose",
      "pause_after": 1.1,
      "text": "Yes. Every star is a message from the past.",
      "pose": {
        "bolt": "sit"
      }
    },
    {
      "id": 15,
      "speaker": "zib",
      "emotion": "excited",
      "camera": "wide",
      "pause_after": 0.9,
      "text": "So the sky is... still loading?",
      "pose": {
        "zib": "stand",
        "bolt": "stand"
      }
    },
    {
      "id": 16,
      "speaker": "bolt",
      "emotion": "deadpan",
      "camera": "boltClose",
      "pause_after": 0.0,
      "text": "Please never say that again."
